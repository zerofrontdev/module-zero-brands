{
    "name": "zerofront/module-zero-brands",
    "description": "Zero for Magento Open Source: shop by brand: a page per brand, an A–Z of brands, the brand on product pages.",
    "type": "magento2-module",
    "version": "1.3.5",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
